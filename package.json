{
  "name": "express",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "db:studio": "drizzle-kit studio",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "seed:demo-user": "tsx scripts/seed-demo-user.ts",
    "seed:students": "tsx scripts/seed-students.ts",
    "seed:dotnet-subject": "tsx scripts/seed-dotnet-subject.ts",
    "seed:cpp-subject": "tsx scripts/seed-cpp-subject.ts",
    "seed:os-subject": "tsx scripts/seed-os-subject.ts",
    "seed:all": "npm run seed:demo-user && npm run seed:dotnet-subject && npm run seed:cpp-subject && npm run seed:os-subject",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "start": "tsx src/server.ts",
    "start:prod": "node dist/server.js"
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
