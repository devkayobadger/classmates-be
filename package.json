    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.22.0",
    "pino": "^9.7.0",
    "swagger-ui-express": "^5.0.1",
    "tsx": "^4.20.5",
    "zod": "^4.3.4"
  },
  "devDependencies": {
