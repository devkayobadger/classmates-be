NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=express_js
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/express_js
JWT_ACCESS=replace_with_a_long_random_access_secret
JWT_REFRESH=replace_with_a_long_random_refresh_secret
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info
RUN_MIGRATIONS=true